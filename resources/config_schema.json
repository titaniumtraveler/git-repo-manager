{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config.toml",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "writeOnly": true
    },
    "default": {
      "type": "object",
      "properties": {
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "open": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "tree": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "default": {
        "host": null,
        "open": null,
        "repo": null,
        "tree": null
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "alias": {
                "type": "array",
                "default": [],
                "items": {
                  "type": "string"
                }
              },
              "default": {
                "type": "boolean",
                "default": false
              },
              "host": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "manifest": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "merge": {
                "$ref": "#/$defs/merge",
                "default": {
                  "behavior": "merge",
                  "only-if": ""
                }
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "default": {}
    },
    "open": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "type": "object",
            "properties": {
              "alias": {
                "type": "array",
                "default": [],
                "items": {
                  "type": "string"
                }
              },
              "command": {
                "type": "array",
                "default": [],
                "items": {
                  "type": "string"
                }
              },
              "default": {
                "type": "boolean",
                "default": false
              },
              "directory": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "environment": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {}
              },
              "manifest": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "merge": {
                "$ref": "#/$defs/merge",
                "default": {
                  "behavior": "merge",
                  "only-if": ""
                }
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "default": {}
    },
    "repo": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "alias": {
                "type": "array",
                "default": [],
                "items": {
                  "type": "string"
                }
              },
              "default": {
                "type": "boolean",
                "default": false
              },
              "manifest": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "merge": {
                "$ref": "#/$defs/merge",
                "default": {
                  "behavior": "merge",
                  "only-if": ""
                }
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "path": {
                "description": "path pointing to the repo\n- if template, potentially pointing to multiple\n- allows for `${entry/name}`\n  ```toml\n  [tree.default]\n  path = \"~/${entry.name}\"\n  name = \"projects/${host.name}/${repo.name}.git\"\n  manifest = true\n  ```",
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "default": {}
    },
    "tree": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "alias": {
                "type": "array",
                "default": [],
                "items": {
                  "type": "string"
                }
              },
              "branch": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "default": {
                "type": "boolean",
                "default": false
              },
              "manifest": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "merge": {
                "$ref": "#/$defs/merge",
                "default": {
                  "behavior": "merge",
                  "only-if": ""
                }
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "path": {
                "description": "path pointing to the tree\n- if template, potentially pointing to multiple\n- allows for `${entry/name}`\n  ```toml\n  [tree.default]\n  path = \"~/${entry.name}\"\n  name = \"projects/${host.name}/${repo.name}/${tree.name}\"\n  manifest = true\n  ```",
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "default": {}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "merge": {
      "type": "object",
      "properties": {
        "behavior": {
          "$ref": "#/$defs/merge-behavior",
          "default": "merge"
        },
        "only-if": {
          "$ref": "#/$defs/merge-only-if",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "merge-behavior": {
      "type": "string",
      "enum": [
        "merge",
        "replace"
      ]
    },
    "merge-only-if": {
      "type": "string",
      "enum": [
        "",
        "present",
        "not-present"
      ]
    }
  }
}
