{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config.toml",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "writeOnly": true
    },
    "checkout": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/checkout"
      },
      "default": {}
    },
    "default": {
      "$ref": "#/$defs/default",
      "default": {
        "checkout": null,
        "host": null,
        "open": null,
        "storage": null
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/host"
      },
      "default": {}
    },
    "open": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/open"
      },
      "default": {}
    },
    "repo": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/repo"
      },
      "default": {}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "checkout": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "boolean",
              "default": false
            },
            "merge": {
              "$ref": "#/$defs/merge",
              "default": {
                "behavior": "merge",
                "only-if": ""
              }
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "default": {
      "type": "object",
      "properties": {
        "checkout": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "open": {
          "type": [
            "string",
            "null"
          ]
        },
        "storage": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "host": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "alias": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "default": {
              "type": "boolean",
              "default": false
            },
            "host": {
              "type": [
                "string",
                "null"
              ]
            },
            "merge": {
              "$ref": "#/$defs/merge",
              "default": {
                "behavior": "merge",
                "only-if": ""
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "merge": {
      "type": "object",
      "properties": {
        "behavior": {
          "$ref": "#/$defs/merge-behavior",
          "default": "merge"
        },
        "only-if": {
          "$ref": "#/$defs/merge-only-if",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "merge-behavior": {
      "type": "string",
      "enum": [
        "merge",
        "replace"
      ]
    },
    "merge-only-if": {
      "type": "string",
      "enum": [
        "",
        "present",
        "not-present"
      ]
    },
    "open": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "default": {
              "type": "boolean",
              "default": false
            },
            "merge": {
              "$ref": "#/$defs/merge",
              "default": {
                "behavior": "merge",
                "only-if": ""
              }
            },
            "working-directory": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "command"
          ]
        }
      ]
    },
    "repo": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "boolean",
              "default": false
            },
            "merge": {
              "$ref": "#/$defs/merge",
              "default": {
                "behavior": "merge",
                "only-if": ""
              }
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
